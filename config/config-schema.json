{
  "title": "CuSus Configuration",
  "version": 2,
  "sections": [
    {
      "id": "audio",
      "label": "Audio",
      "description": "Audio upload, decoding, and master volume defaults.",
      "fields": [
        { "key": "audio.upload.maxMb", "label": "Upload limit MB", "type": "number", "default": 300, "min": 10, "max": 2048, "step": 1 },
        { "key": "audio.buffer.sampleRate", "label": "Sample rate", "type": "select", "default": 48000, "options": [44100, 48000] },
        { "key": "audio.buffer.channels", "label": "Channels", "type": "select", "default": 2, "options": [1, 2] },
        { "key": "audio.buffer.maxCached", "label": "Max cached buffers", "type": "number", "default": 0, "min": 0, "max": 256, "step": 1 },
        { "key": "audio.masterVolume.defaultDb", "label": "Default master dB", "type": "number", "default": 0, "min": -40, "max": 15, "step": 0.5 },
        { "key": "audio.masterVolume.minDb", "label": "Minimum master dB", "type": "number", "default": -40, "min": -80, "max": 0, "step": 0.5 },
        { "key": "audio.masterVolume.maxDb", "label": "Maximum master dB", "type": "number", "default": 15, "min": 0, "max": 24, "step": 0.5 }
      ]
    },
    {
      "id": "realtime",
      "label": "Realtime",
      "description": "WebSocket sync and refresh timing.",
      "fields": [
        { "key": "realtime.instanceBroadcastMs", "label": "Instance broadcast ms", "type": "number", "default": 200, "min": 50, "max": 1000, "step": 10 },
        { "key": "realtime.reconnectDelayMs", "label": "Reconnect delay ms", "type": "number", "default": 2000, "min": 250, "max": 20000, "step": 250 }
      ]
    },
    {
      "id": "ui",
      "label": "UI",
      "description": "Cue editor defaults.",
      "fields": [
        { "key": "ui.cues.defaultManualFadeOutSeconds", "label": "Default fade out s", "type": "number", "default": 2, "min": 0.1, "max": 30, "step": 0.1 }
      ]
    },
    {
      "id": "timecode",
      "label": "Timecode",
      "description": "Network targets for timecode, OSC, and console playback commands.",
      "fields": [
        {
          "key": "osc.targets",
          "label": "Targets",
          "type": "json",
          "default": [{ "ip": "127.0.0.1", "oscPort": 8000, "remotePort": 6553 }],
          "multiline": true,
          "help": "JSON array. Set remotePort to -1 to force OSC."
        }
      ]
    },
    {
      "id": "system",
      "label": "System",
      "description": "Local operator notes.",
      "fields": [
        { "key": "system.notes", "label": "Notes", "type": "text", "default": "", "multiline": true, "exposeToClient": false }
      ]
    }
  ]
}
