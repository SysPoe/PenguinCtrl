#include <windows.h>

1 RT_MANIFEST "cusus.exe.manifest"

1 VERSIONINFO
FILEVERSION @VERSION_COMMAS@
PRODUCTVERSION @VERSION_COMMAS@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "CuSus"
      VALUE "FileDescription", "CuSus show control and media playback"
      VALUE "InternalName", "cusus"
      VALUE "OriginalFilename", "cusus.exe"
      VALUE "ProductName", "CuSus"
      VALUE "FileVersion", "@VERSION_STRING@"
      VALUE "ProductVersion", "@VERSION_STRING@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
